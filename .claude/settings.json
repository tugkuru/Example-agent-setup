{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/safety-gate.sh\" || exit 2",
            "timeout": 10,
            "statusMessage": "Safety gate: checking for secret access and dangerous commands..."
          }
        ]
      }
    ]
  }
}
